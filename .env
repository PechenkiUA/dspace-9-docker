# ─── DSpace version ────────────────────────────────────────────────────────────
DSPACE_VERSION=9.0

# ─── Public URLs (nginx is the single entry point on PROXY_PORT) ──────────────
DSPACE_SERVER_URL=http://localhost/server
DSPACE_UI_URL=http://localhost

# ─── Repository name ──────────────────────────────────────────────────────────
DSPACE_NAME=My DSpace Repository

# ─── Administrator account (created on first start) ───────────────────────────
DSPACE_ADMIN_EMAIL=admin@example.com
DSPACE_ADMIN_PASS=changeme
DSPACE_ADMIN_FIRSTNAME=DSpace
DSPACE_ADMIN_LASTNAME=Administrator

# ─── Database ─────────────────────────────────────────────────────────────────
DB_NAME=dspace
DB_USER=dspace
DB_PASS=dspace

# ─── Ports ────────────────────────────────────────────────────────────────────
PROXY_PORT=80        # main entry point (nginx)  → http://localhost
BACKEND_PORT=8080    # direct backend access      → http://localhost:8080/server
SOLR_PORT=8983       # Solr admin UI              → http://localhost:8983/solr

# ─── JVM memory (increase for large repos) ────────────────────────────────────
JAVA_OPTS=-Xmx2g -Xms512m -Dfile.encoding=UTF-8
