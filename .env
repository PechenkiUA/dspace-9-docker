# ─── DSpace version ────────────────────────────────────────────────────────────
DSPACE_VERSION=9.0

# ─── Public URLs (must be reachable from the browser) ─────────────────────────
DSPACE_SERVER_URL=http://localhost:8080/server
DSPACE_UI_URL=http://localhost:4000
# When running behind a reverse proxy on the same host, set this to the
# internal Docker service name so the Angular SSR can reach the backend:
DSPACE_REST_HOST=localhost

# ─── Repository name ──────────────────────────────────────────────────────────
DSPACE_NAME=My DSpace Repository

# ─── Administrator account (created on first start) ───────────────────────────
DSPACE_ADMIN_EMAIL=admin@example.com
DSPACE_ADMIN_PASS=changeme
DSPACE_ADMIN_FIRSTNAME=DSpace
DSPACE_ADMIN_LASTNAME=Administrator

# ─── Database ─────────────────────────────────────────────────────────────────
DB_NAME=dspace
DB_USER=dspace
DB_PASS=dspace

# ─── Ports ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=4000
SOLR_PORT=8983

# ─── JVM memory (increase for large repos) ────────────────────────────────────
JAVA_OPTS=-Xmx2g -Xms512m -Dfile.encoding=UTF-8
