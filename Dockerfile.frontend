# syntax=docker/dockerfile:1
ARG DSPACE_VERSION=9.0

# ─── Stage 1: Build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
ARG DSPACE_VERSION

WORKDIR /app

RUN apk add --no-cache curl python3 make g++

# Download dspace-angular source
RUN curl -fsSL \
    "https://github.com/DSpace/dspace-angular/archive/refs/tags/dspace-${DSPACE_VERSION}.tar.gz" \
    | tar xz --strip-components=1

# Install dependencies (uses package-lock.json from the release)
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline

# Production build (SSR + browser bundles)
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN npm run build:prod

# ─── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM node:20-alpine AS runtime

WORKDIR /app

# Copy only what's needed to run
COPY --from=builder /app/dist /app/dist
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/package.json /app/package.json
COPY --from=builder /app/config /app/config

EXPOSE 4000

# dspace-angular SSR entry point — adjust if your version uses a different path
CMD ["node", "dist/server/main.js"]
